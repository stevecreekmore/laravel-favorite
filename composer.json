{
  "name": "stevecreekmore/laravel-favorite",
  "description": "User favorite system for Laravel.",
  "license": "MIT",
  "authors": [
    {
      "name": "Steve Creekmore",
      "email": "creekmore108@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "laravel/framework": "^9.0|^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Stevecreekmore\\LaravelFavorite\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "require-dev": {
    "mockery/mockery": "^1.5",
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0|^9.0",
    "laravel/pint": "^1.5"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Stevecreekmore\\LaravelFavorite\\FavoriteServiceProvider"
      ]
    }
  },
  "scripts": {
    "check-style": "vendor/bin/pint --test",
    "fix-style": "vendor/bin/pint",
    "test": "phpunit --colors=always"
  },
  "scripts-descriptions": {
    "test": "Run all tests.",
    "check-style": "Run style checks (only dry run - no fixing!).",
    "fix-style": "Run style checks and fix violations."
  }
}
